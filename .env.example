# Copy this file to .env and fill in real values there. .env is
# git-ignored (see .gitignore) and docker-ignored (see .dockerignore) - it
# never gets committed or baked into the image. Never put real secrets in
# this .env.example file itself.

# --- Metadata providers ---------------------------------------------
# Free v4 read-access token from https://www.themoviedb.org/settings/api
UMMARR_TMDB_TOKEN=
# Free API key from https://www.omdbapi.com/apikey.aspx
UMMARR_OMDB_API_KEY=

# --- Indexer (Prowlarr) ----------------------------------------------
# Base URL of your existing Prowlarr instance, reachable from this
# container - if Prowlarr isn't on the same Docker network, use your
# Docker host's IP and Prowlarr's mapped port, e.g. http://media-server:9696
UMMARR_PROWLARR_BASE_URL=
# Prowlarr -> Settings -> General -> Security -> API Key
UMMARR_PROWLARR_API_KEY=

# --- Download client (Deluge) ----------------------------------------
# Deluge's Web UI base URL, reachable from this container, e.g.
# http://media-server:8112
UMMARR_DELUGE_BASE_URL=
# Deluge's Web UI password (Preferences -> Interface -> Password) - NOT
# the daemon's own user/password auth, the separate Web UI login.
UMMARR_DELUGE_PASSWORD=

# --- Web UI login ------------------------------------------------------
# The password you'll use to log into UMMarr's web UI. Leaving this empty
# disables login entirely - the site is then open to anyone who can reach
# it, which is NOT recommended once this is reachable beyond your own
# machine.
UMMARR_AUTH_PASSWORD=
# 32 random bytes, base64-encoded, used to encrypt session cookies
# (AES-256-GCM). Generate one with:
#   openssl rand -base64 32
# If left empty, a random key is generated at container startup instead -
# it works, but every login session is invalidated on every restart.
UMMARR_SESSION_KEY=
# Optional shared secret required as a ?token= query param on the
# /downloads/{hash}/completed webhook (see README's Deluge "Execute"
# plugin setup) - independent of the login above, since a download
# client's own script can't hold a browser session. Generate one with:
#   openssl rand -hex 24
# Leave empty to leave that one route without a token requirement.
UMMARR_WEBHOOK_TOKEN=

# --- Misc ----------------------------------------------------------------
# Address+port the server listens on inside the container - only change
# this if you also update the port mapping in docker-compose.yml.
UMMARR_LISTEN_ADDR=:8080
